# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=4000

# Origin of the front-end (for CORS). e.g. http://localhost:5173 or https://yourdomain.com
CORS_ORIGIN=http://localhost:5500

# Long, random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Where the SQLite database file is stored
DATABASE_FILE=./data/quran.db

# Set to "production" when deployed behind HTTPS
NODE_ENV=development
